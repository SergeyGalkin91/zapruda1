# Copy to .env.docker and set your public Supabase project values.
# These are public browser keys, NOT service-role or sb_secret_ keys.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Optional internal Supabase URL when running through a private network.
SUPABASE_URL=
